<!--Defination of joints: joint_a0-joint5-->
<joint
name="joint_a0"
type="revolute">
<origin
  xyz="0.041 0 0"
  rpy="0 0 0" />
<parent
  link="segment_head" />
<child
  link="segment_body_1" />
<axis
  xyz="0 0 1" />
<limit
  lower="-1.57"
  upper="1.57"
  effort="10"
  velocity="10" />
</joint>

<joint
name="joint_a1"
type="revolute">
<origin
  xyz="0.02675 0 0"
  rpy="0 0 0" />
<parent
  link="segment_body_1" />
<child
  link="segment_body_2" />
<axis
  xyz="0 0 1" />
<limit
  lower="-1.57"
  upper="1.57"
  effort="10"
  velocity="10" />
</joint>

