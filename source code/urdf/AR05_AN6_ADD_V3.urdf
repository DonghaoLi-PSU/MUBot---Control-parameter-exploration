<link
  name="dummy_link">
  <inertial>
    <origin
      xyz="0.02175 0.0 0.0"
      rpy="0 0 0" />
    <mass
      value="1.485E-01" />
    <inertia
      ixx="1.652E-05"
      ixy="0.0"
      ixz="0.0"
      iyy="2.237E-05"
      iyz="0.0"
      izz="8.532E-05" />
  </inertial>
  <visual>
    <origin
      xyz="0 0 0"
      rpy="0 0 0" />
    <geometry>
      <mesh
        filename="package://des_mubot/meshes/segment_head.STL" scale="1 1 1"/>
    </geometry>
    <material
      name="">
      <color
        rgba="1 0 0 1" />
    </material>
  </visual>
  <collision>
    <origin
      xyz="0 0 0"
      rpy="0 0 0" />
    <geometry>
      <mesh
        filename="package://des_mubot/meshes/segment_head.STL" scale="1 1 1"/>
    </geometry>
  </collision>
</link>

