<!--Defination of joints: joint0-joint5-->
<joint
name="joint_a0"
type="revolute">
<origin
  xyz="0.041 0 0"
  rpy="0 0 0" />
<parent
  link="segment_head" />
<child
  link="segment_body_1" />
<axis
  xyz="0 0 1" />
<limit
  lower="-1.57"
  upper="1.57"
  effort="10"
  velocity="10" />
</joint>

<joint
name="joint_a1"
type="revolute">
<origin
  xyz="0.02675 0 0"
  rpy="0 0 0" />
<parent
  link="segment_body_1" />
<child
  link="segment_body_2" />
<axis
  xyz="0 0 1" />
<limit
  lower="-1.57"
  upper="1.57"
  effort="10"
  velocity="10" />
</joint>

<joint
name="joint_a2"
type="revolute">
<origin
  xyz="0.02675 0 0"
  rpy="0 0 0" />
<parent
  link="segment_body_2" />
<child
  link="segment_body_3" />
<axis
  xyz="0 0 1" />
<limit
  lower="-1.57"
  upper="1.57"
  effort="10"
  velocity="10" />
</joint>

<joint
name="joint_a3"
type="revolute">
<origin
  xyz="0.02675 0 0"
  rpy="0 0 0" />
<parent
  link="segment_body_3" />
<child
  link="segment_tail" />
<axis
  xyz="0 0 1" />
<limit
  lower="-1.57"
  upper="1.57"
  effort="10"
  velocity="10" />
</joint>

<joint
name="joint_p0"
type="revolute">
<origin
  xyz="0.02175 0 0"
  rpy="0 0 0" />
<parent
  link="segment_tail" />
<child
  link="segment_tip" />
<axis
  xyz="0 0 1" />
<limit
  lower="-1.57"
  upper="1.57"
  effort="10"
  velocity="10" />
</joint>



<gazebo reference="dummy_link">
    <material>Gazebo/Red</material>
</gazebo>

<gazebo reference="segment_body_1">
    <material>Gazebo/Yellow</material>
</gazebo>
<gazebo reference="segment_body_2">
    <material>Gazebo/Yellow</material>
</gazebo>
<gazebo reference="segment_body_3">
    <material>Gazebo/Yellow</material>
</gazebo>

<gazebo reference="segment_tail">
    <material>Gazebo/Orange</material>
</gazebo>

<gazebo reference="segment_tip">
    <material>Gazebo/Blue</material>
</gazebo>

<gazebo>
    <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
        <robotNamespace>/mubot</robotNamespace>
    </plugin>
</gazebo>


  <gazebo>
        <plugin name="Actuator_control" filename="libactuator_plugin.so"/>
        <plugin name="Hydro_Plugin" filename="libHydro_plugin.so"/>
  </gazebo>


<gazebo>
    <plugin name="p3d_base_controller" filename="libgazebo_ros_p3d.so">
        <robotNamespace>/mubot</robotNamespace>
        <alwaysOn>true</alwaysOn>
        <updateRate>2000.0</updateRate>
        <bodyName>segment_head</bodyName>
        <topicName>odom0</topicName>
        <gaussianNoise>0.01</gaussianNoise>
        <frameName>world</frameName>
        <xyzOffsets>0 0 0</xyzOffsets>
        <rpyOffsets>0 0 0</rpyOffsets>
    </plugin>
</gazebo>


 <transmission name="joint_a0_trans">
   <type>transmission_interface/SimpleTransmission</type>
   <joint name="joint_a0">
     <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
   </joint>
   <actuator name="joint_a0_Motor">
     <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
     <mechanicalReduction>1</mechanicalReduction>
   </actuator>
 </transmission>


</robot>
