<?xml version="1.0" encoding="utf-8"?>
<robot
  name="mubot">


<!--  AR01_AN24_RES -->


<link
  name="dummy_link">
  <inertial>
    <origin
      xyz="0.02175 0.0 0.0"
      rpy="0 0 0" />
    <mass
      value="3.713E-02" />
    <inertia
      ixx="1.032E-06"
      ixy="0.0"
      ixz="0.0"
      iyy="3.134E-06"
      iyz="0.0"
      izz="2.528E-06" />
  </inertial>
  <visual>
    <origin
      xyz="0 0 0"
      rpy="0 0 0" />
    <geometry>
      <mesh
        filename="package://des_mubot/meshes/segment_head.STL" scale="1 1 1"/>
    </geometry>
    <material
      name="">
      <color
        rgba="1 0 0 1" />
    </material>
  </visual>
  <collision>
    <origin
      xyz="0 0 0"
      rpy="0 0 0" />
    <geometry>
      <mesh
        filename="package://des_mubot/meshes/segment_head.STL" scale="1 1 1"/>
    </geometry>
  </collision>
</link>

