<?xml version="1.0"?>
<sdf version="1.10">
  <world name="open_water">
    <!-- Zero gravity and a 0.25 ms step, as in the legacy mubot.world.
         real_time_factor 0 runs as fast as possible (training). -->
    <gravity>0 0 0</gravity>
    <physics name="quarter_ms" type="dart">
      <max_step_size>0.00025</max_step_size>
      <real_time_factor>0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- No sensor systems: training workers never render. -->
  </world>
</sdf>
