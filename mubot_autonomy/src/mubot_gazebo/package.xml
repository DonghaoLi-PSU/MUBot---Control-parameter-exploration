<?xml version="1.0"?>
<package format="3">
  <name>mubot_gazebo</name>
  <version>0.1.0</version>
  <description>μBot Gazebo systems (hydrodynamics, actuators), worlds and ROS bridge.</description>
  <maintainer email="donghao.gerald.li@gmail.com">Donghao Li</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>mubot_interfaces</depend>
  <depend>gz_sim_vendor</depend>
  <depend>gz_plugin_vendor</depend>
  <depend>gz_transport_vendor</depend>
  <depend>gz_msgs_vendor</depend>
  <depend>yaml-cpp</depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_image</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
